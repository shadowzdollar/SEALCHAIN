# Production settings. Copy to .env on the server (and for `pnpm go-live`).
# `pnpm dev` does not read .env; put local-only overrides in .env.local instead.
# ---- Server
DOMAIN=app.example.com                          # production: the hostname Caddy serves (deploy/)
CONTACT_EMAIL=pilot@example.com                 # receives "Talk to us" requests
PORT=4100
PUBLIC_WEB_URL=https://verify.example.com      # printed in every document's QR code
CORS_ORIGINS=https://verify.example.com
DATA_DIR=/data                                  # SQLite DB + issuer key (absolute path)
ADMIN_EMAILS=compliance@example.com             # registrations granted the compliance role
# ISSUER_KEY_PEM="-----BEGIN PRIVATE KEY-----..." # Ed25519 issuer key (else generated in DATA_DIR)

# ---- Anchoring (omit RPC_URL and no local deployment => development ledger)
# RPC_URL=https://rpc-amoy.polygon.technology
# PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology  # queried directly by verifiers' browsers
# CHAIN_ID=80002
# CHAIN_NAME=Polygon Amoy testnet
# ANCHOR_CONTRACT=0x...                          # from `pnpm --filter @sealchain/contracts deploy remote`
# ANCHOR_PRIVATE_KEY=0x...                       # funded account allowed to anchor
# EXPLORER_TX_URL=https://amoy.polygonscan.com/tx/{tx}
# ANCHOR_INTERVAL_MS=20000
# ANCHOR_CONFIRMATIONS=2
# ANCHOR_MAX_GAS_GWEI=50                       # defer anchoring while fees are above this
# ANCHOR_MIN_BALANCE=0.01                       # warn when the anchor wallet runs low
# Check the whole setup before go-live:  pnpm anchor:preflight
# Create a dedicated anchor wallet:       pnpm --filter @sealchain/api anchor:wallet

# ---- Online payment of statements (see requirement.md §8)
# FLW_SECRET_KEY=FLWSECK_TEST-…                  # Flutterwave secret key; enables "Pay now"
# FLW_WEBHOOK_HASH=…                             # secret hash set in Flutterwave → Webhooks
#                                                # webhook URL: https://<domain>/api/payments/webhook/flutterwave
# PAYMENT_CURRENCY=RWF                           # what payers are charged in (mobile money needs RWF)
# MANUAL_PAYMENT_INSTRUCTIONS="MoMo pay code 123456 · Bank of Kigali 000-000 · quote your organisation name"

# ---- Pilot pricing (USD cents)
PLAN_MONTHLY_CENTS=1500
# Plans (cents / seats). Pilot is priced by PLAN_MONTHLY_CENTS and PER_SHIPMENT_CENTS.
PLAN_PILOT_SEATS=3
PLAN_GROWTH_MONTHLY_CENTS=4900
PLAN_GROWTH_PER_SHIPMENT_CENTS=200
PLAN_GROWTH_SEATS=15
PER_SHIPMENT_CENTS=300

# ---- FX reference rates for threshold checks (units per USD)
# FX_RATES_JSON={"RWF":1450,"KES":129}

# ---- Mail (invites, password resets). Without a key, mail is printed to the server log.
# MAIL_API_KEY=re_...                           # Resend API key
# MAIL_FROM=SealChain <no-reply@yourdomain>

# ---- Backups:  pnpm backup [dir]   (online SQLite backup; keeps BACKUP_KEEP=14 newest)

# ---- Sign in with Google / Apple (buttons always show; they work once configured) — see docs/SIGN_IN.md
# OAUTH_REDIRECT_BASE=https://app.example.com   # defaults to PUBLIC_WEB_URL
# GOOGLE_CLIENT_ID=….apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=…
# APPLE_CLIENT_ID=com.example.sealchain.web     # the Services ID
# APPLE_TEAM_ID=ABCDE12345
# APPLE_KEY_ID=XYZ987654A
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----"

# ---- Check everything before go-live:  pnpm go-live   (see docs/GO_LIVE.md)
